# Токен от @BotFather
BOT_TOKEN=

# Ключи (бесплатные тарифы): https://aistudio.google.com/apikey и https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Модели. Ничего менять не нужно: актуальные имена уже зашиты в код. Раскомментируй строку,
# только если хочешь другую модель. Закреплённое устаревшее имя бот обойдёт сам.
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3.6-flash
# GROQ_LLM_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=qwen/qwen3.8-27b
# GROQ_STT_MODEL=whisper-large-v3-turbo

# Пусто = бот открыт всем. Иначе только эти Telegram ID через запятую (узнать: @userinfobot).
ALLOWED_USER_IDS=

# Суточные лимиты на пользователя
LIMIT_LLM_PER_DAY=40
LIMIT_STT_PER_DAY=40
LIMIT_VISION_PER_DAY=10

# INFO для отладки. На сервере ставь WARNING: в журнале только ошибки, диск не растёт.
LOG_LEVEL=INFO
