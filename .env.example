# Токен от @BotFather
BOT_TOKEN=

# Ключи (бесплатные тарифы): https://aistudio.google.com/apikey и https://console.groq.com/keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Модели меняются у провайдеров, поэтому имена здесь, а не в коде.
GEMINI_MODEL=gemini-flash-latest
GROQ_LLM_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_STT_MODEL=whisper-large-v3-turbo

# Пусто = бот открыт всем. Иначе только эти Telegram ID через запятую (узнать: @userinfobot).
ALLOWED_USER_IDS=

# Суточные лимиты на пользователя
LIMIT_LLM_PER_DAY=40
LIMIT_STT_PER_DAY=40
LIMIT_VISION_PER_DAY=10
